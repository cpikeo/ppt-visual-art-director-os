{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cpikeo/ppt-visual-art-director-os/schemas/plan.schema.json",
  "title": "plan.json 数据契约（vao.py plan 的落盘产物）",
  "description": "结构、类型、必需字段与合法枚举的唯一声明处。`why` / `necessity` / `limit` / `discipline` / `whitespace_duty` 不列为必需：瘦身投影会把全稿只出现一次的同一句说明上提到 deck.legend，页内不再抄；「要么在页内、要么在 legend」由 intelligence.validate_plan 检查。跨字段语义（页数与 coherence 对齐、chart_kind 是否在 CHART_KINDS、numerals 的 lean/full 一致性）由 intelligence.validate_plan 用 Python 检查：schema 管形状，Python 管含义。判据说明见 SKILL.md §3，字段用法见 references/contract.md。",
  "type": "object",
  "required": [
    "deck",
    "pages",
    "warnings",
    "workflow"
  ],
  "additionalProperties": false,
  "properties": {
    "deck": {
      "$ref": "#/$defs/deck"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "assets_hint": {
      "$ref": "#/$defs/assetsHint"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "planning_ms": {
      "type": "number",
      "minimum": 0
    },
    "performance": {
      "type": "object"
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "颜色只写 #HEX（token 名在 spec 层合法，plan 里必须是已解析的色值）。"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enumEvidence": {
      "enum": [
        "comparison",
        "series",
        "part_whole",
        "number",
        "structure",
        "sequence",
        "proposition",
        "none"
      ]
    },
    "enumRole": {
      "enum": [
        "establish",
        "explain",
        "compare",
        "prove",
        "persuade",
        "summarize"
      ]
    },
    "enumComposition": {
      "enum": [
        "big_whitespace",
        "data_field",
        "linear_structure",
        "asymmetric_tension",
        "editorial",
        "image_narrative"
      ]
    },
    "enumDensity": {
      "enum": [
        "sparse",
        "balanced",
        "dense"
      ]
    },
    "enumRhythm": {
      "enum": [
        "open",
        "build",
        "breathe",
        "turn",
        "hold",
        "close"
      ]
    },
    "enumEmphasis": {
      "enum": [
        "climax",
        "quiet",
        "lead",
        "support"
      ]
    },
    "enumMedia": {
      "enum": [
        "required",
        "reuse",
        "none"
      ]
    },
    "enumFocusType": {
      "enum": [
        "text",
        "chart",
        "image"
      ]
    },
    "enumFocusRole": {
      "enum": [
        "image_subject",
        "image_witness",
        "ratio_main",
        "comparison_field",
        "kpi_main",
        "structure_map",
        "statement_text",
        "headline",
        "decision_ask",
        "action_ask",
        "criteria_ask"
      ]
    },
    "enumProvenance": {
      "enum": [
        "author",
        "judgment",
        "hint",
        "decision",
        "absent",
        "frame"
      ]
    },
    "enumClaimSource": {
      "enum": [
        "declared",
        "extracted",
        "absent",
        "frame"
      ]
    },
    "enumTensionSource": {
      "enum": [
        "author",
        "deck",
        "not_asserted"
      ]
    },
    "enumTypeStep": {
      "enum": [
        "stat",
        "display",
        "title",
        "lead",
        "subtitle",
        "body",
        "caption",
        "source"
      ]
    },
    "deck": {
      "type": "object",
      "required": [
        "audience",
        "decision",
        "tension",
        "type_scale",
        "world",
        "theme",
        "coherence",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "tension": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_scale": {
          "type": "object",
          "required": [
            "stat",
            "display",
            "title",
            "lead",
            "subtitle",
            "body",
            "caption",
            "source",
            "chart_label",
            "chart_value",
            "shape_text"
          ],
          "additionalProperties": false,
          "properties": {
            "stat": {
              "type": "number",
              "minimum": 1
            },
            "display": {
              "type": "number",
              "minimum": 1
            },
            "title": {
              "type": "number",
              "minimum": 1
            },
            "lead": {
              "type": "number",
              "minimum": 1
            },
            "subtitle": {
              "type": "number",
              "minimum": 1
            },
            "body": {
              "type": "number",
              "minimum": 1
            },
            "caption": {
              "type": "number",
              "minimum": 1
            },
            "source": {
              "type": "number",
              "minimum": 1
            },
            "chart_label": {
              "type": "number",
              "minimum": 1
            },
            "chart_value": {
              "type": "number",
              "minimum": 1
            },
            "shape_text": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "world": {
          "type": "object",
          "required": [
            "name",
            "source",
            "visual_world",
            "light",
            "texture_keys",
            "chart_style",
            "composition_grammar",
            "type_voice",
            "fonts",
            "paper",
            "ink",
            "accent",
            "accent_role",
            "accent_why",
            "reasons"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmpty"
            },
            "source": {
              "$ref": "#/$defs/nonEmpty"
            },
            "visual_world": {
              "$ref": "#/$defs/nonEmpty"
            },
            "light": {
              "type": "string"
            },
            "texture_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "chart_style": {
              "type": "string"
            },
            "composition_grammar": {
              "enum": [
                "strict_grid",
                "soft_asymmetry",
                "evidence_field"
              ]
            },
            "type_voice": {
              "$ref": "#/$defs/nonEmpty"
            },
            "fonts": {
              "type": "object",
              "required": [
                "cn",
                "latin"
              ],
              "additionalProperties": false,
              "properties": {
                "cn": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "latin": {
                  "$ref": "#/$defs/nonEmpty"
                }
              }
            },
            "paper": {
              "$ref": "#/$defs/hexColor"
            },
            "ink": {
              "$ref": "#/$defs/hexColor"
            },
            "accent": {
              "$ref": "#/$defs/hexColor"
            },
            "accent_role": {
              "type": "string"
            },
            "accent_why": {
              "type": "string"
            },
            "reasons": {
              "type": "object",
              "required": [
                "register",
                "subject",
                "regime",
                "accent_role",
                "composition",
                "type_voice"
              ],
              "additionalProperties": false,
              "properties": {
                "register": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "regime": {
                  "type": "string"
                },
                "accent_role": {
                  "type": "string"
                },
                "composition": {
                  "type": "string"
                },
                "type_voice": {
                  "type": "string"
                }
              }
            }
          }
        },
        "theme": {
          "type": "object",
          "required": [
            "colors_seed",
            "seed_source"
          ],
          "additionalProperties": false,
          "properties": {
            "colors_seed": {
              "type": "object",
              "required": [
                "foundation",
                "information",
                "supporting",
                "accent"
              ],
              "additionalProperties": false,
              "properties": {
                "foundation": {
                  "$ref": "#/$defs/hexColor"
                },
                "information": {
                  "$ref": "#/$defs/hexColor"
                },
                "supporting": {
                  "$ref": "#/$defs/hexColor"
                },
                "accent": {
                  "$ref": "#/$defs/hexColor"
                }
              }
            },
            "seed_source": {
              "enum": [
                "brand_colors",
                "world_derivation"
              ]
            },
            "slots_overridden": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "foundation",
                  "information",
                  "supporting",
                  "accent"
                ]
              }
            }
          }
        },
        "coherence": {
          "type": "object",
          "required": [
            "compositions",
            "densities",
            "roles",
            "media",
            "climax"
          ],
          "additionalProperties": false,
          "properties": {
            "compositions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/enumComposition"
              }
            },
            "densities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/enumDensity"
              }
            },
            "roles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/enumRole"
              }
            },
            "media": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(required|reuse|none):(-|[A-Za-z_]+)$"
              }
            },
            "climax": {
              "type": "object",
              "required": [
                "page",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "why": {
                  "type": "string"
                }
              }
            },
            "adjustments": {
              "type": [
                "array",
                "null"
              ]
            },
            "notes": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "description": "生效策略摘要：判断可追溯到当时用的阈值版本。",
          "required": [
            "version",
            "sha256",
            "tunable_groups"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "$ref": "#/$defs/nonEmpty"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "overrides": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "tunable_groups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "legend": {
          "type": "object",
          "description": "瘦身投影上提的重复说明句（key = 判断路径）。",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "ref",
        "judgment"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "description": "页原文（标题 + 正文），BUILD 的唯一原文来源。"
        },
        "anchor": {
          "oneOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "declarations": {
          "type": [
            "object",
            "null"
          ],
          "description": "作者声明的回显（原样生效）。键的权威清单是 intelligence._PAGE_DECLARATIONS；多写一个键不改变判断，但不会被消费。",
          "additionalProperties": true
        },
        "judgment": {
          "$ref": "#/$defs/judgment"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "judgment": {
      "type": "object",
      "required": [
        "claim",
        "tension",
        "information_weight",
        "visual_role",
        "focus",
        "composition",
        "spatial",
        "typography",
        "media",
        "production",
        "understanding",
        "rhythm",
        "emphasis",
        "provenance",
        "open_questions"
      ],
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim": {
          "type": "object",
          "required": [
            "text",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/enumClaimSource"
            },
            "why": {
              "type": "string"
            }
          }
        },
        "tension": {
          "type": "object",
          "required": [
            "issue",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "issue": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/enumTensionSource"
            },
            "why": {
              "type": "string"
            }
          }
        },
        "information_weight": {
          "type": "object",
          "required": [
            "maximize",
            "weaken",
            "delete"
          ],
          "additionalProperties": false,
          "properties": {
            "maximize": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "weaken": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "delete": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "delete_candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "visual_role": {
          "type": "object",
          "required": [
            "role"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "$ref": "#/$defs/enumRole"
            },
            "why": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/enumProvenance"
            },
            "alternatives": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "array",
                  "items": {
                    "type": "array"
                  }
                }
              ]
            }
          }
        },
        "focus": {
          "type": "object",
          "required": [
            "element_role",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "element_role": {
              "$ref": "#/$defs/enumFocusRole"
            },
            "type": {
              "$ref": "#/$defs/enumFocusType"
            },
            "why": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/enumProvenance"
            },
            "chart_kind": {
              "type": "string",
              "description": "合法值以 primitives.CHART_SPEC 为唯一来源，由 intelligence.validate_plan 用 Python 查（不在 schema 里抄一份）。"
            },
            "chart_kind_why": {
              "type": "string"
            },
            "rejected": {
              "$ref": "#/$defs/rejected"
            }
          }
        },
        "composition": {
          "type": "object",
          "required": [
            "chosen"
          ],
          "additionalProperties": false,
          "properties": {
            "chosen": {
              "$ref": "#/$defs/enumComposition"
            },
            "why": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/enumProvenance"
            },
            "rejected": {
              "$ref": "#/$defs/rejected"
            }
          }
        },
        "spatial": {
          "type": "object",
          "required": [
            "reading_path",
            "primary_zone",
            "quiet_zone"
          ],
          "additionalProperties": false,
          "properties": {
            "reading_path": {
              "type": "string"
            },
            "primary_zone": {
              "type": "string"
            },
            "quiet_zone": {
              "type": "string"
            },
            "whitespace_duty": {
              "type": "string"
            }
          }
        },
        "typography": {
          "type": "object",
          "required": [
            "lead",
            "scale"
          ],
          "additionalProperties": false,
          "properties": {
            "lead": {
              "type": "string"
            },
            "support": {
              "type": [
                "string",
                "null"
              ]
            },
            "discipline": {
              "type": "string"
            },
            "scale": {
              "type": "object",
              "required": [
                "lead_break",
                "body_measure_cjk",
                "step",
                "size"
              ],
              "additionalProperties": false,
              "properties": {
                "lead_break": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "body_measure_cjk": {
                  "type": "integer",
                  "minimum": 8,
                  "maximum": 80
                },
                "step": {
                  "$ref": "#/$defs/enumTypeStep"
                },
                "size": {
                  "type": "number",
                  "minimum": 1
                },
                "why": {
                  "type": "string"
                },
                "limit": {
                  "type": "string"
                },
                "lead_rewrite": {
                  "type": "string"
                }
              }
            }
          }
        },
        "media": {
          "type": "object",
          "required": [
            "decision",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "$ref": "#/$defs/enumMedia"
            },
            "source": {
              "$ref": "#/$defs/enumProvenance"
            },
            "function": {
              "type": [
                "string",
                "null"
              ]
            },
            "suggested": {
              "type": "string"
            },
            "necessity": {
              "type": "string"
            }
          }
        },
        "production": {
          "type": "object",
          "required": [
            "must_place",
            "must_not",
            "density_target"
          ],
          "additionalProperties": false,
          "properties": {
            "must_place": {
              "$ref": "#/$defs/mustPlace"
            },
            "must_not": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "density_target": {
              "$ref": "#/$defs/enumDensity"
            }
          }
        },
        "understanding": {
          "anyOf": [
            {
              "$ref": "#/$defs/understandingFull"
            },
            {
              "$ref": "#/$defs/understandingLean"
            }
          ]
        },
        "rhythm": {
          "type": "object",
          "required": [
            "move"
          ],
          "additionalProperties": false,
          "properties": {
            "move": {
              "$ref": "#/$defs/enumRhythm"
            },
            "previous": {
              "type": [
                "string",
                "null"
              ]
            },
            "why": {
              "type": "string"
            }
          }
        },
        "emphasis": {
          "type": "object",
          "required": [
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "$ref": "#/$defs/enumEmphasis"
            },
            "why": {
              "type": "string"
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "open_questions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "understandingFull": {
      "type": "object",
      "required": [
        "evidence",
        "numerals",
        "distinct_numerals",
        "numeric_density",
        "subjects",
        "human",
        "scene",
        "individual",
        "comparison",
        "part_whole",
        "same_unit",
        "has_chart"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/enumEvidence"
        },
        "evidence_source": {
          "enum": [
            "author",
            "judgment"
          ]
        },
        "relations": {
          "type": "array"
        },
        "numerals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "raw",
              "value",
              "unit",
              "year"
            ],
            "additionalProperties": false,
            "properties": {
              "raw": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "year": {
                "type": "boolean"
              }
            }
          }
        },
        "distinct_numerals": {
          "type": "integer",
          "minimum": 0
        },
        "numeric_density": {
          "type": "number",
          "minimum": 0
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human": {
          "type": "boolean"
        },
        "scene": {
          "type": "boolean"
        },
        "individual": {
          "type": "boolean"
        },
        "comparison": {
          "type": "boolean"
        },
        "part_whole": {
          "type": "boolean"
        },
        "same_unit": {
          "type": "boolean"
        },
        "has_chart": {
          "type": "boolean"
        },
        "mixed_metrics": {
          "type": "boolean",
          "description": "页上有 ≥2 个量、但认不出任何形状（非序列/比较/构成/并列）：并置，关系由作者补。"
        },
        "share_of": {
          "type": "object",
          "description": "单句份额陈述的分母标签与比例（「履约成本占总成本 61%」→ 总成本/61）。语义校验只查形状；标签是否真的指向整体属判断，留 Python。",
          "required": [
            "whole_label",
            "pct"
          ],
          "additionalProperties": false,
          "properties": {
            "whole_label": {
              "type": "string",
              "minLength": 1
            },
            "pct": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "total_value": {
          "type": "number",
          "description": "分解成立时的整体值（子项相加等于它）；焦点理由据此点名「谁是整体」。"
        }
      }
    },
    "understandingLean": {
      "type": "object",
      "description": "瘦身投影：numerals 只留 raw，布尔只留为真的那些。",
      "required": [
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/enumEvidence"
        },
        "evidence_source": {
          "enum": [
            "author",
            "judgment"
          ]
        },
        "relations": {
          "type": "array"
        },
        "numerals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "comparison",
              "part_whole",
              "same_unit",
              "has_chart",
              "human",
              "scene",
              "individual",
              "mixed_metrics"
            ]
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distinct_numerals": {
          "type": "integer",
          "minimum": 0
        },
        "numeric_density": {
          "type": "number",
          "minimum": 0
        },
        "mixed_metrics": {
          "type": "boolean",
          "description": "页上有 ≥2 个量、但认不出任何形状（非序列/比较/构成/并列）：并置，关系由作者补。"
        }
      }
    },
    "rejected": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "option",
              "why_not"
            ],
            "additionalProperties": false,
            "properties": {
              "option": {
                "type": "string"
              },
              "why_not": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "mustPlace": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+:(text|chart|image)$"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "$ref": "#/$defs/enumFocusType"
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "decided_by",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "decided_by": {
          "type": "object",
          "required": [
            "claim",
            "evidence",
            "role",
            "focus",
            "composition",
            "media",
            "rhythm",
            "emphasis"
          ],
          "additionalProperties": false,
          "properties": {
            "claim": {
              "$ref": "#/$defs/enumProvenance"
            },
            "evidence": {
              "$ref": "#/$defs/enumProvenance"
            },
            "role": {
              "$ref": "#/$defs/enumProvenance"
            },
            "focus": {
              "$ref": "#/$defs/enumProvenance"
            },
            "composition": {
              "$ref": "#/$defs/enumProvenance"
            },
            "media": {
              "$ref": "#/$defs/enumProvenance"
            },
            "rhythm": {
              "$ref": "#/$defs/enumProvenance"
            },
            "emphasis": {
              "$ref": "#/$defs/enumProvenance"
            }
          }
        },
        "author_declared": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "pending_author": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "assetsHint": {
      "type": "object",
      "required": [
        "generate"
      ],
      "additionalProperties": false,
      "properties": {
        "generate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "rule",
        "scope",
        "msg"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "$ref": "#/$defs/nonEmpty"
        },
        "scope": {
          "type": "string"
        },
        "msg": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string"
        }
      }
    },
    "workflow": {
      "type": "object",
      "description": "计划凭证：brief 的字节摘要与产出路径。brief 改了必须重跑 plan。",
      "required": [
        "planned_at",
        "brief_path",
        "brief_file_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "planned_at": {
          "type": "string",
          "minLength": 20
        },
        "brief_path": {
          "$ref": "#/$defs/nonEmpty"
        },
        "brief_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "skeleton_path": {
          "type": "string"
        },
        "assets_manifest_path": {
          "type": "string"
        }
      }
    }
  }
}
